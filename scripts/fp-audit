#!/data/data/com.termux/files/usr/bin/python3
"""fp-audit — verify the running browser's anti-bot fingerprint via CDP websocket.

Checks the exact signals Cloudflare reads:
  navigator.webdriver  must be false
  UA                   must not contain Headless
  navigator.plugins    should be > 0
  window.chrome        should exist
Exit 0 only if webdriver=false and UA clean (the two hard-fail signals).

Usage: fp-audit [port]
"""
import json
import socket
import struct
import sys
import urllib.parse  # noqa: E402
import urllib.request

port = int(sys.argv[1]) if len(sys.argv) > 1 else 9222
base = f"http://127.0.0.1:{port}"


def http_json(path, method="GET", body=None):
    req = urllib.request.Request(base + path, method=method,
                                 data=json.dumps(body).encode() if body else None,
                                 headers={"content-type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read())


# --- get the page target + its websocket debugger URL ---
targets = http_json("/json/list")
page = next((t for t in targets if t["type"] == "page"), None)
if not page:
    print("FAIL: no page target")
    sys.exit(1)
ws_url = page["webSocketDebuggerUrl"]

# --- minimal websocket client (no deps) ---
class WS:
    def __init__(self, url):
        u = urllib.parse.urlparse(url)
        self.sock = socket.create_connection((u.hostname, u.port), timeout=10)
        key = __import__("base64").b64encode(__import__("os").urandom(16)).decode()
        path = u.path + (f"?{u.query}" if u.query else "")
        self.sock.sendall((
            f"GET {path} HTTP/1.1\r\nHost: {u.hostname}:{u.port}\r\n"
            f"Upgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
            f"Sec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            buf += self.sock.recv(4096)

    def send(self, payload: str):
        data = payload.encode()
        mask = __import__("os").urandom(4)
        header = bytearray([0x81])
        n = len(data)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126); header += struct.pack(">H", n)
        else:
            header.append(0x80 | 127); header += struct.pack(">Q", n)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        self.sock.sendall(bytes(header) + mask + masked)

    def recv_msg(self, timeout=10):
        self.sock.settimeout(timeout)
        buf = b""

        def read(n):
            nonlocal buf
            while len(buf) < n:
                chunk = self.sock.recv(4096)
                if not chunk:
                    raise ConnectionError("closed")
                buf += chunk

        read(2)
        b1, b2 = buf[0], buf[1]
        ln = b2 & 0x7F
        off = 2
        if ln == 126:
            read(2); ln = struct.unpack(">H", buf[2:4])[0]; off = 4
        elif ln == 127:
            read(8); ln = struct.unpack(">Q", buf[2:10])[0]; off = 10
        read(off + ln)
        return buf[off:off + ln].decode("utf-8", "replace")


import urllib.parse  # already imported at top  # noqa: F401
ws = WS(ws_url)
expr = ("JSON.stringify({wd:navigator.webdriver, ua:navigator.userAgent,"
        "plugins:navigator.plugins.length, chrome:!!window.chrome, "
        "langs:navigator.languages, hw:navigator.hardwareConcurrency})")
ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate",
                    "params": {"expression": expr, "returnByValue": True}}))
# read frames until our id=1 result
result = None
for _ in range(20):
    try:
        msg = json.loads(ws.recv_msg())
    except Exception:
        break
    if msg.get("id") == 1:
        result = msg
        break
if not result:
    print("FAIL: no CDP response")
    sys.exit(1)

val = result["result"]["result"]["value"]
fp = json.loads(val)

print(f"UA        : {fp['ua'][:70]}")
print(f"webdriver : {fp['wd']}")
print(f"plugins   : {fp['plugins']}")
print(f"window.chrome : {fp['chrome']}")
print(f"langs     : {fp['langs']}")

hard_ok = (fp["wd"] is False) and ("Headless" not in fp["ua"])
soft_ok = fp["plugins"] > 0 and fp["chrome"]
print()
print("VERDICT:", "CLEAN ✅ (Turnstile-grade)" if hard_ok else "DIRTY ❌ (will fail interactive challenges)")
if hard_ok and not soft_ok:
    print("  (hard signals clean; plugins/chrome soft-missing — usually still passes)")
sys.exit(0 if hard_ok else 1)
