#!/usr/bin/env python3
"""clean-fp-chrome — launch a Turnstile-grade Chromium. Cross-platform.

On Termux/arm64: uses the system chromium binary directly.
On desktop Linux/macOS/Windows: auto-detects Chrome/Chromium/Edge.
In Docker/CI: falls back to Playwright's bundled chromium if installed.

WHY THIS EXISTS (proven 2026-11-20, app.anoman.io production Turnstile):
  headless_shell with low-end flags  -> navigator.webdriver=true, UA "HeadlessChrome",
                                        interactive challenge ALWAYS fails verification
  chrome --headless=new + clean args -> challenge DOWNGRADES to non-interactive,
                                        token auto-lands in ~9 s, zero clicks

The difference is not the skill or the script — it is how the browser process is born.
Cloudflare reads signals INSIDE the challenge iframe (OOPIF); patching the parent
page's navigator does nothing. Fix it at launch or not at all.

Usage:
  clean-fp-chrome                                  # spawn on :9222 with profile-clean
  clean-fp-chrome --profile gui                    # named profile (e.g. saved logins)
  clean-fp-chrome --check                          # fingerprint audit of running browser
  clean-fp-chrome --kill                           # stop it
  clean-fp-chrome --browser /path/to/chrome        # explicit browser binary
  clean-fp-chrome --proxy socks5://host:port       # route through proxy
"""
import json
import os
import shutil
import signal
import subprocess
import sys
import time
import urllib.request

PORT = 9222
PROFILE_NAME = "clean"
BROWSER_BIN = None
PROXY = None

# Override PORT from --port flag
for i, a in enumerate(sys.argv[1:]):
    if a == "--port" and i + 1 < len(sys.argv[1:]):
        try:
            PORT = int(sys.argv[1:][i + 1])
        except ValueError:
            pass

# Real Chrome UA — not HeadlessChrome. Cloudflare checks this.
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
      "(KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36")


def find_browser():
    """Auto-detect Chrome/Chromium/Edge on the system."""
    global BROWSER_BIN
    if BROWSER_BIN:
        return BROWSER_BIN

    # 1. Termux: system chromium
    termux_paths = [
        "/data/data/com.termux/files/usr/lib/chromium/chrome",
        "/data/data/com.termux/files/usr/bin/chromium",
    ]
    for p in termux_paths:
        if os.path.isfile(p) and os.access(p, os.X_OK):
            BROWSER_BIN = p
            return BROWSER_BIN

    # 2. Linux: google-chrome, chromium, chromium-browser
    for name in ["google-chrome", "google-chrome-stable", "chromium",
                 "chromium-browser", "chrome"]:
        p = shutil.which(name)
        if p:
            BROWSER_BIN = p
            return BROWSER_BIN

    # 3. macOS
    mac_paths = [
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge",
    ]
    for p in mac_paths:
        if os.path.isfile(p):
            BROWSER_BIN = p
            return BROWSER_BIN

    # 4. Windows
    win_paths = [
        os.path.expandvars(r"%ProgramFiles%\Google\Chrome\Application\chrome.exe"),
        os.path.expandvars(r"%ProgramFiles(x86)%\Google\Chrome\Application\chrome.exe"),
        os.path.expandvars(r"%LocalAppData%\Google\Chrome\Application\chrome.exe"),
        os.path.expandvars(r"%ProgramFiles%\Microsoft\Edge\Application\msedge.exe"),
    ]
    for p in win_paths:
        if os.path.isfile(p):
            BROWSER_BIN = p
            return BROWSER_BIN

    # 5. Playwright bundled chromium
    pw = shutil.which("playwright")
    if pw:
        try:
            result = subprocess.run([pw, "install", "--dry-run", "chromium"],
                                    capture_output=True, text=True, timeout=5)
            for line in result.stdout.splitlines():
                if "chromium" in line.lower() and "/" in line:
                    BROWSER_BIN = line.strip().split()[-1]
                    if os.path.isfile(BROWSER_BIN):
                        return BROWSER_BIN
        except Exception:
            pass

    print("ERROR: No Chrome/Chromium found. Install one of:", file=sys.stderr)
    print("  Termux:  pkg install chromium", file=sys.stderr)
    print("  Debian:  apt install chromium", file=sys.stderr)
    print("  macOS:   brew install --cask google-chrome", file=sys.stderr)
    print("  Any:     npx playwright install chromium", file=sys.stderr)
    print("Or pass --browser /path/to/chrome", file=sys.stderr)
    sys.exit(1)


def cdp_version():
    """Check if a browser is already running on PORT."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/json/version",
                                    timeout=2) as r:
            return json.loads(r.read())
    except Exception:
        return None


def kill_browser():
    """Kill any browser holding PORT."""
    try:
        # Find PID via /json/version
        ver = cdp_version()
        if ver:
            ws_url = ver.get("webSocketDebuggerUrl", "")
            # Try pkill on the port pattern (Linux/macOS)
            subprocess.run(["pkill", "-f", f"remote-debugging-port={PORT}"],
                           capture_output=True, timeout=5)
            time.sleep(1)
    except Exception:
        pass
    # Also try taskkill on Windows
    if sys.platform == "win32":
        subprocess.run(["taskkill", "/f", "/im", "chrome.exe"],
                       capture_output=True, timeout=5)
    if cdp_version():
        print("still running", file=sys.stderr)
        sys.exit(1)
    print("killed")


def spawn_browser():
    """Launch a clean-fingerprint browser."""
    global PROFILE_NAME, PROXY, BROWSER_BIN

    args = sys.argv[1:]

    # Parse --profile
    if "--profile" in args:
        idx = args.index("--profile")
        if idx + 1 < len(args):
            PROFILE_NAME = args[idx + 1]

    # Parse --browser
    if "--browser" in args:
        idx = args.index("--browser")
        if idx + 1 < len(args):
            BROWSER_BIN = args[idx + 1]

    # Parse --proxy
    if "--proxy" in args:
        idx = args.index("--proxy")
        if idx + 1 < len(args):
            PROXY = args[idx + 1]

    bin_path = find_browser()
    profile = os.path.expanduser(f"~/.cache/hermes-browser/profile-{PROFILE_NAME}")
    os.makedirs(profile, exist_ok=True)

    if cdp_version():
        print(f"browser already running on :{PORT} — kill first: "
              f"clean-fp-chrome --kill", file=sys.stderr)
        sys.exit(1)

    args = [
        bin_path,
        "--headless=new",
        "--no-sandbox",
        "--disable-dev-shm-usage",
        f"--remote-debugging-address=127.0.0.1",
        f"--remote-debugging-port={PORT}",
        f"--user-data-dir={profile}",
        f"--user-agent={UA}",
        "--window-size=800,600",
        "--disable-blink-features=AutomationControlled",
    ]
    if PROXY:
        args.append(f"--proxy-server={PROXY}")

    args.append("about:blank")

    log_file = os.path.expanduser("~/.cache/hermes-browser/chrome-clean.log")
    os.makedirs(os.path.dirname(log_file), exist_ok=True)

    fh = open(log_file, "w")
    proc = subprocess.Popen(args, stdout=fh, stderr=fh, start_new_session=True)
    fh.close()

    # Wait for CDP
    for _ in range(15):
        time.sleep(1)
        if cdp_version():
            print(f"UP  pid={proc.pid} port={PORT} profile=profile-{PROFILE_NAME}")
            print(f"next: fp-audit {PORT}")
            return

    print(f"FAILED to start — log: {log_file}", file=sys.stderr)
    try:
        with open(log_file) as f:
            for line in f.readlines()[-5:]:
                print(line, end="", file=sys.stderr)
    except Exception:
        pass
    sys.exit(1)


def check_browser():
    """Quick fingerprint audit without the full fp-audit script."""
    ver = cdp_version()
    if not ver:
        print(f"FAIL: no browser on :{PORT}", file=sys.stderr)
        sys.exit(1)
    ua = ver.get("Browser", "")
    print(f"Browser: {ua}")
    if "Headless" in ua:
        print("FAIL: UA contains Headless — challenge will fail", file=sys.stderr)
        sys.exit(1)
    if "Chrome" in ua or "Chromium" in ua or "Edg" in ua:
        print("PASS: UA is real Chrome (not HeadlessChrome)")
    else:
        print(f"WARN: unexpected UA: {ua}")
    print(f"\nFull audit: python3 fp-audit {PORT}")


def main():
    args = sys.argv[1:]

    # If no args, spawn with defaults (profile-clean, port 9222)
    if not args:
        spawn_browser()
        return

    if args[0] == "--kill":
        kill_browser()
        return

    if args[0] == "--check":
        check_browser()
        return

    if args[0] in ("--help", "-h"):
        print(__doc__)
        return

    spawn_browser()


if __name__ == "__main__":
    main()